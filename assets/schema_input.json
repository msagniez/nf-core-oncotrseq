{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/oncotrseq/master/assets/schema_input.json",
    "title": "nf-core/oncotrseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "biotype": {
                "type": "string",
                "pattern": "^\\S+$",
                "enum": ["cdna", "drna"]
            },
            "tumor_type": {
                "type": "string",
                "pattern": "^\\S+$",
                "enum": ["all", "aml", "other", "cascade"],
                "default": "cascade"
            },
            "input": {
                "type": "string",
                "format": "path",
                "exists": true,
                "errorMessage": "fastq, bam file or quantification file path must be provided"
            },
            "ref_genome": {
                "type": ["string", "null"],
                "format": "file-path",
                "exists": true,
                "errorMessage": "Path to reference genome (.fa) must be provided if using biotype_counts parameter"
            },
            "ref_rna": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "Path to reference transcriptome (.fa) must be provided"
            },
            "gtf": {
                "type": ["string", "null"],
                "format": "file-path",
                "exists": true,
                "errorMessage": "Path to reference annotation GTF file must be provided"
            }
        },
        "required": ["sample", "biotype", "tumor_type","input"]
    }
}