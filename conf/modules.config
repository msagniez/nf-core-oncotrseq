/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/program_outputs/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'QUARTO_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_TOFASTQ' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-T '*'"
    }

    withName: 'SAMTOOLS_INDEX_FULL' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CRAMINO_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/cramino" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_ALIGN_CDNA' {
        ext.args = "-ax splice"
    }

    withName: 'MINIMAP2_ALIGN_DRNA' {
        ext.args = "-ax splice -uf -k14"
    }

    withName: 'OARFISH_QUANTIFY_GENOMEALIGNMENTPROJECTION' {
        ext.prefix = {
            "${meta.id}_${meta.timepoint}_${meta.ref_name}_${meta.ref_gtf}"
        }
        publishDir = [
            path: { "${params.outdir}/quantification" },
            mode: params.publish_dir_mode,
            pattern: '*.quant',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // meta.id is a stable sample identifier and is never suffixed anywhere in
    // this pipeline (see workflows/oncotrseq.nf). Any per-timepoint
    // (meta.timepoint) or per-reference (meta.ref_name) disambiguation needed
    // in output filenames is reconstructed here instead, so every module gets
    // a unique prefix without the identity fields used for channel joins ever
    // changing. This must stay AFTER the withName blocks above - Nextflow's
    // config parser fails to recognise `withName:` selectors that come after
    // a top-level `ext.*` closure assignment in the same process{} block.
    ext.prefix = { "${meta.id}${meta.timepoint ? '_' + meta.timepoint : ''}${meta.ref_name ? '_' + meta.ref_name : ''}" }

}